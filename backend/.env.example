# Vakil AI backend — every settable env var. Copy to backend/.env; `make
# backend` auto-loads it. Uncomment only what you need.

# ── Google Drive connector (read-only, user OAuth) ──────────────────────────
# 1. GCP console: create OAuth client (type: Web application), enable Drive API.
# 2. Add authorized redirect URI: http://localhost:8787/auth/google/callback
# 3. Download the client secret JSON, point GOOGLE_OAUTH_CLIENT_FILE at it.
# 4. DRIVE_FOLDER_ID = the id segment from the folder URL:
#    https://drive.google.com/drive/folders/<THIS_PART>
# 5. Start backend, click "Connect Drive" in the UI, consent in browser.
#    Token stored at backend/credentials/token.json (gitignored), auto-refreshed.
GOOGLE_OAUTH_CLIENT_FILE=./credentials/client_secret.json
DRIVE_FOLDER_ID=
# DRIVE_OAUTH_REDIRECT_URI=http://localhost:8787/auth/google/callback

# ── Config selection (config.py) ────────────────────────────────────────────
# Alternate config file (default: backend/config.yaml).
# VAKIL_CONFIG=./config.yaml
# Retrieval profile override (default: active_profile in config.yaml).
# VAKIL_PROFILE=nomic-default
# Chat model override (default: generation.active in config.yaml).
# VAKIL_CHAT_MODEL=llama

# ── API-provider chat models (llm/openai_compat.py) ─────────────────────────
# Keys live HERE, never in config.yaml (committed). The var NAME must match
# the model's api_key_env in config.yaml (e.g. the deepseek-api entry).
# DEEPSEEK_API_KEY=sk-...

# ── Server (main.py) ────────────────────────────────────────────────────────
# Where OAuth redirects land back in the browser (the Vite dev server).
# FRONTEND_URL=http://localhost:5173
